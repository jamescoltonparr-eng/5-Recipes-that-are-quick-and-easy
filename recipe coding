<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Quick & Easy Recipes</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #fff7f0;
      padding: 20px;
    }

    h1, h2 {
      text-align: center;
      color: #d35400;
    }

    .recipes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .recipe {
      background: white;
      padding: 15px;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    img {
      width: 100%;
      border-radius: 8px;
    }

    button {
      background: #e67e22;
      color: white;
      border: none;
      padding: 8px;
      margin-top: 8px;
      width: 100%;
      cursor: pointer;
      border-radius: 5px;
    }

    textarea, input {
      width: 100%;
      margin-top: 5px;
      padding: 6px;
    }

    .comments {
      margin-top: 10px;
      font-size: 14px;
    }

    .comment {
      background: #f4f4f4;
      padding: 5px;
      margin-top: 5px;
      border-radius: 4px;
    }

    .add-recipe {
      background: white;
      padding: 15px;
      border-radius: 10px;
      margin-top: 40px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
  </style>
</head>
<body>

<h1>🍽 Quick & Easy Recipes</h1>

<div id="recipes" class="recipes"></div>

<div class="add-recipe">
  <h2>Add Your Own Recipe</h2>
  <input id="title" placeholder="Recipe name">
  <input id="image" placeholder="Image URL">
  <input id="ingredients" placeholder="Ingredients (comma separated)">
  <input id="steps" placeholder="Quick steps">
  <button onclick="addRecipe()">Add Recipe</button>
</div>

<script>
  let recipes = JSON.parse(localStorage.getItem("recipes")) || [
    {
      title: "Spaghetti",
      image: "https://images.unsplash.com/photo-1589302168068-964664d93dc0",
      ingredients: ["Pasta", "Jar sauce"],
      steps: "Boil pasta, heat sauce, mix.",
      comments: []
    },
    {
      title: "Cheeseburger",
      image: "https://images.unsplash.com/photo-1550547660-d9450f859349",
      ingredients: ["Bun", "Patty", "Cheese"],
      steps: "Cook patty, assemble burger.",
      comments: []
    },
    {
      title: "Pizza",
      image: "https://images.unsplash.com/photo-1548365328-8b849e6c7b45",
      ingredients: ["Dough", "Sauce", "Cheese"],
      steps: "Top dough, bake 15 mins.",
      comments: []
    },
    {
      title: "Pancakes",
      image: "https://images.unsplash.com/photo-1587738347118-3e29a0b2c6c4",
      ingredients: ["Mix", "Milk"],
      steps: "Mix and cook on pan.",
      comments: []
    },
    {
      title: "Salad",
      image: "https://images.unsplash.com/photo-1555939594-58d7cb561ad1",
      ingredients: ["Lettuce", "Tomato"],
      steps: "Chop and mix.",
      comments: []
    }
  ];

  function save() {
    localStorage.setItem("recipes", JSON.stringify(recipes));
  }

  function render() {
    const container = document.getElementById("recipes");
    container.innerHTML = "";

    recipes.forEach((r, i) => {
      container.innerHTML += `
        <div class="recipe">
          <img src="${r.image}">
          <h3>${r.title}</h3>
          <p><strong>Ingredients:</strong> ${r.ingredients.join(", ")}</p>
          <p><strong>Steps:</strong> ${r.steps}</p>

          <textarea id="c${i}" placeholder="Add a comment"></textarea>
          <button onclick="addComment(${i})">Post Comment</button>

          <div class="comments">
            ${r.comments.map(c => `<div class="comment">${c}</div>`).join("")}
          </div>
        </div>
      `;
    });
  }

  function addComment(i) {
    const text = document.getElementById("c" + i).value;
    if (text) {
      recipes[i].comments.push(text);
      save();
      render();
    }
  }

  function addRecipe() {
    const title = document.getElementById("title").value;
    const image = document.getElementById("image").value;
    const ingredients = document.getElementById("ingredients").value.split(",");
    const steps = document.getElementById("steps").value;

    if (title && image && steps) {
      recipes.push({ title, image, ingredients, steps, comments: [] });
      save();
      render();
    }
  }

  render();
</script>

</body>
</html>
